# ===== .env cho docker-compose.prod.yml (đặt trên VPS, KHÔNG commit) =====
# Copy file này thành .env rồi điền giá trị thật.

# Domain trỏ về IP VPS (cho HTTPS tự động). Dùng ":80" nếu chỉ HTTP bằng IP.
DOMAIN=nhanong.duckdns.org
PUBLIC_URL=https://nhanong.duckdns.org

# ── MySQL ──
DB_NAME=farmer_system
DB_USER=longd
DB_PASSWORD=ĐỔI_mật_khẩu_mạnh
DB_ROOT_PASSWORD=ĐỔI_root_mạnh

# ── Auth ──
JWT_SECRET=ĐỔI_chuỗi_ngẫu_nhiên_dài

# ── Cloudinary (LẤY KHÓA MỚI — khóa cũ đã lộ trong git, phải rotate) ──
CLOUDINARY_CLOUD_NAME=xxx
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx
CLOUDINARY_FOLDER=nha-nong

# ── ML service (chạy chung trong docker-compose, service 'ml') ──
# KHÔNG cần đặt ML_SERVICE_URL — backend mặc định dùng http://ml:7860 (nội bộ).
# (Chỉ đặt nếu muốn trỏ ra ML service ngoài.)
ML_TIMEOUT_MS=30000
DIAGNOSIS_CONFIDENCE_THRESHOLD=0.6
